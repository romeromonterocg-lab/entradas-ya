# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3006

# Conexión a PostgreSQL (base orders_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orders_db
DB_USER=orders_user
DB_PASSWORD=orders_pass_dev

# Secreto para validar los JWT (el MISMO que usa auth)
JWT_SECRET=cambiar_por_el_mismo_secreto_de_auth

# Clave para llamar a los servicios internos (MISMO valor en payments, tickets y notifications)
INTERNAL_TOKEN=cambiar_por_la_misma_clave_interna

# Direcciones de los otros servicios
EVENTS_URL=http://localhost:3002
PAYMENTS_URL=http://localhost:3003
TICKETS_URL=http://localhost:3004
NOTIFICATIONS_URL=http://localhost:3005

# Tiempo máximo de espera de cada llamada a otro servicio (ms)
HTTP_TIMEOUT_MS=5000
