# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3007

# Conexión a PostgreSQL (base checkin_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=checkin_db
DB_USER=checkin_user
DB_PASSWORD=checkin_pass_dev

# Secreto para validar los JWT de los porteros (el MISMO que usa auth)
JWT_SECRET=cambiar_por_el_mismo_secreto_de_auth

# Clave para llamar a tickets (MISMO valor que en tickets)
INTERNAL_TOKEN=cambiar_por_la_misma_clave_interna

# Dirección de tickets y tiempo máximo de espera (ms)
TICKETS_URL=http://localhost:3004
HTTP_TIMEOUT_MS=5000
