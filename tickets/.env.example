# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3004

# Conexión a PostgreSQL (base tickets_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tickets_db
DB_USER=tickets_user
DB_PASSWORD=tickets_pass_dev

# Secreto para validar los JWT de los clientes (el MISMO que usa auth)
JWT_SECRET=cambiar_por_el_mismo_secreto_de_auth

# Clave para llamadas internas (orders y checkin la envían en X-Internal-Token)
INTERNAL_TOKEN=cambiar_por_la_misma_clave_interna

# Carpeta local donde se guardan los PDF
PDF_DIR=./storage
