# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3005

# Servidor SMTP (Mailpit en la v1)
SMTP_HOST=localhost
SMTP_PORT=1025
# Tiempo máximo para hablar con el servidor SMTP (ms)
SMTP_TIMEOUT_MS=5000

# Remitente de los correos
MAIL_FROM="EntradasYa <no-reply@entradasya.local>"

# Dirección de la web (para el enlace "ver mis entradas" en el correo)
WEB_URL=http://localhost

# Clave interna: orders la envía en X-Internal-Token (MISMO valor en todos los servicios)
INTERNAL_TOKEN=cambiar_por_la_misma_clave_interna
