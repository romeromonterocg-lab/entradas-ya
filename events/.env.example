# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3002

# Conexión a PostgreSQL (base events_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=events_db
DB_USER=events_user
DB_PASSWORD=events_pass_dev

# Secreto para validar los JWT (el MISMO que usa auth)
JWT_SECRET=cambiar_por_el_mismo_secreto_de_auth
