# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3003

# Conexión a PostgreSQL (base payments_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payments_db
DB_USER=payments_user
DB_PASSWORD=payments_pass_dev

# Clave que orders debe enviar en el header X-Internal-Token.
# Es un servicio interno: solo orders puede llamarlo. El MISMO valor va en orders.
INTERNAL_TOKEN=cambiar_por_una_clave_interna
