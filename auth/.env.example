# Copiar este archivo como .env y completar los valores

# Puerto donde escucha el servicio
PORT=3001

# Conexión a PostgreSQL (base auth_db, usuario propio del servicio)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auth_db
DB_USER=auth_user
DB_PASSWORD=auth_pass_dev

# Secreto para firmar los JWT (el MISMO en todos los servicios que validan tokens)
JWT_SECRET=cambiar_por_un_secreto_largo
# Duración del token (ej: 1h, 8h, 1d)
JWT_EXPIRES_IN=8h
